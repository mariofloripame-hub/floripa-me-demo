SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
ANTHROPIC_API_KEY=
GOOGLE_PLACES_API_KEY=

# CARTO Basemaps API key for removing the "API KEY REQUIRED" watermark from map tiles.
# Get a free key (no credit card required) at: https://carto.com/basemaps/apikey/
# This variable must have the NEXT_PUBLIC_ prefix to be available in client-side code.
NEXT_PUBLIC_CARTO_API_KEY=

# Provedor do LLM usado para gerar roteiros: "anthropic" (padrão) ou "deepseek".
LLM_PROVIDER=anthropic
DEEPSEEK_API_KEY=
